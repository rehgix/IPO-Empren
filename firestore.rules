rules_version = '2';
// Emprèn · Regles de seguretat de la base de dades.
// Només poden entrar comptes dels dominis de l'institut (línia DOMINIS).
service cloud.firestore {
  match /databases/{database}/documents {

    // DOMINIS: correus que poden entrar (professorat i alumnat)
    function domainOk() { return request.auth.token.email.lower().matches('.*@(biada[.]net)$'); }

    function signed() { return request.auth != null && request.auth.token.email_verified == true && domainOk(); }
    function me() { return request.auth.token.email.lower(); }
    function grp(gid) { return get(/databases/$(database)/documents/groups/$(gid)).data; }
    function isProf(gid) { return signed() && me() in grp(gid).profs; }
    function isOwner(gid) { return resource.data.get('owner', null) == request.auth.uid; }
    function memberDoc(gid) { return /databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid); }
    function inTeam(gid, tid) { return signed() && exists(memberDoc(gid)) && get(memberDoc(gid)).data.team == tid; }

    // ADMINISTRADOR: aprova qui pot crear grups (ha de coincidir amb FB_ADMIN de config.js)
    function isAdmin() { return signed() && me() == 'solivares@biada.net'; }
    function canCreate() { return isAdmin() || (signed() && exists(/databases/$(database)/documents/profs/$(me()))); }
    function reqOk(email) {
      let r = request.resource.data;
      return signed() && me() == email && r.keys().hasOnly(['email', 'name', 'msg', 'at', 'status'])
        && r.email == me() && r.status == 'pending'
        && r.name is string && r.name.size() > 0 && r.name.size() <= 100
        && r.msg is string && r.msg.size() <= 500 && r.at is number;
    }

    // APARTATS OBERTS: el grup desa a «w» quan pot escriure l'alumnat cada dada ({ f: des de, u: fins a }, en mil·lisegons).
    // Una dada que no surt a «w» (grups antics o apartats nous) es pot escriure sempre.
    function winOk(w, k) { return !(k in w) || (request.time.toMillis() >= w[k].f && request.time.toMillis() < w[k].u); }
    // BLOQUEIG PER EQUIP: el professorat desa a «ov» de l'equip, per apartat, 'x' quan una activitat independent ja té nota:
    // l'equip ja no hi pot tocar res. «k» és la dada i «s» l'apartat on s'omple. Un apartat tancat (a mà o per data) no es reobre mai.
    function ovOk(w, ov, k, s) { return ov.get(s, '') != 'x' && winOk(w, k); }
    function keyOk(aff, w, ov, k, s) { return !(k in aff) || ovOk(w, ov, k, s); }
    function studentEditOk(gid) {
      let w = grp(gid).get('w', {});
      let ov = resource.data.get('ov', {});
      let aff = request.resource.data.get('data', {}).diff(resource.data.get('data', {})).affectedKeys();
      // Si només canvia la marca d'«enviat» (_meta) o cap dada, no cal mirar apartat per apartat
      return (aff.hasOnly(['_meta']) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['members'])) ||
        keyOk(aff, w, ov, 'idea', 'idea') && keyOk(aff, w, ov, 'empatia', 'empatia') && keyOk(aff, w, ov, 'entrevistes', 'entrevistes') && keyOk(aff, w, ov, 'definir', 'definir')
        && keyOk(aff, w, ov, 'prototip', 'prototip') && keyOk(aff, w, ov, 'micro', 'micro') && keyOk(aff, w, ov, 'pestel', 'pestel') && keyOk(aff, w, ov, 'dafo', 'dafo')
        && keyOk(aff, w, ov, 'lean', 'lean') && keyOk(aff, w, ov, 'ebc', 'ebc') && keyOk(aff, w, ov, 'agents', 'agents') && keyOk(aff, w, ov, 'juridica', 'juridica')
        && keyOk(aff, w, ov, 'fiscal', 'fiscal') && keyOk(aff, w, ov, 'inversio', 'inversio') && keyOk(aff, w, ov, 'prestec', 'prestec') && keyOk(aff, w, ov, 'treso', 'treso')
        && keyOk(aff, w, ov, 'viab', 'viab') && keyOk(aff, w, ov, 'marca', 'marca') && keyOk(aff, w, ov, 'pitch', 'pitch') && keyOk(aff, w, ov, 'p7', 'p7')
        // Dades que s'omplen des d'un altre apartat: el finançament (a «inversio») i la sostenibilitat (a «sost» i «lean»)
        && keyOk(aff, w, ov, 'finan', 'inversio')
        && (keyOk(aff, w, ov, 'sost', 'sost') || ovOk(w, ov, 'sost', 'lean'))
        && keyOk(request.resource.data.diff(resource.data).affectedKeys(), w, ov, 'members', 'equip');
    }
    // DADES DE L'EQUIP: només els apartats que existeixen (més _meta: enviats, i _who: qui ha escrit cada cosa)
    function dataKeysOk() {
      return request.resource.data.get('data', {}).diff(resource.data.get('data', {})).affectedKeys().hasOnly(['idea', 'empatia', 'entrevistes', 'definir',
        'prototip', 'micro', 'pestel', 'dafo', 'lean', 'sost', 'ebc', 'agents', 'juridica', 'fiscal', 'inversio', 'finan',
        'prestec', 'treso', 'viab', 'marca', 'pitch', 'p7', '_meta', '_who']);
    }
    // LLIURAMENT: la data ha de ser la d'ara (amb un marge d'una hora pel rellotge de l'ordinador); no es pot posar una data antiga
    function deliveredOk() {
      let r = request.resource.data;
      let now = request.time.toMillis();
      return !r.diff(resource.data).affectedKeys().hasAny(['delivered']) || r.delivered == null
        || (r.delivered is number && r.delivered > now - 3600000 && r.delivered < now + 3600000);
    }
    // ARXIUS: imatges i documents del prototip i el logo (màxim 1 MB i amb data d'esborrat del grup)
    // Noms d'arxiu fixos (u0-u29 per a prototip i esbossos, l0-l4 per al logo): així un equip no pot omplir la base de dades
    function fileIdOk(fid) { return fid.matches('^(u[12]?[0-9]|l[0-4])$'); }
    function studentFileOk(gid, tid, fid) {
      let f = request.resource.data;
      return f.keys().hasOnly(['name', 'kind', 'size', 'data', 'expiresAt'])
        && f.name is string && f.name.size() <= 300 && f.kind in ['img', 'doc', 'logo']
        && f.data is string && f.data.size() < 1000000
        && f.expiresAt is timestamp && f.expiresAt <= grp(gid).expiresAt
        && filesOpen(gid, tid) && fileIdOk(fid);
    }
    function filesOpen(gid, tid) {
      let w = grp(gid).get('w', {});
      let ov = get(/databases/$(database)/documents/groups/$(gid)/teams/$(tid)).data.get('ov', {});
      return ovOk(w, ov, 'prototip', 'prototip') || ovOk(w, ov, 'marca', 'marca');
    }

    // PROFESSORAT AUTORITZAT: el document es diu com el correu
    match /profs/{email} {
      allow get: if isAdmin() || (signed() && me() == email);
      allow list, write: if isAdmin();
    }
    // CONTRASENYA de les còpies de seguretat (el document es diu com el correu): només la veu i la canvia el mateix professor
    match /bkkeys/{email} {
      allow get: if signed() && me() == email;
      // També es desa si les còpies estan activades i quan es va fer l'última (perquè no torni a preguntar a cada ordinador)
      allow create, update: if signed() && me() == email && request.resource.data.keys().hasOnly(['pw', 'at', 'on', 'last', 'n', 'ask', 'askAt'])
        && request.resource.data.pw is string && request.resource.data.pw.size() <= 200 && request.resource.data.at is number
        && (!('on' in request.resource.data) || request.resource.data.on is bool)
        && (!('last' in request.resource.data) || request.resource.data.last is number)
        && (!('n' in request.resource.data) || request.resource.data.n is number)
        && (!('ask' in request.resource.data) || request.resource.data.ask is number)
        && (!('askAt' in request.resource.data) || request.resource.data.askAt is number);
    }
    // SOL·LICITUDS d'accés com a professor (una per correu)
    match /profreq/{email} {
      allow get: if isAdmin() || (signed() && me() == email);
      allow list, update, delete: if isAdmin();
      allow create: if reqOk(email);
    }

    match /groups/{gid} {
      // Llegir el grup: els seus professors, els seus alumnes, qui té una invitació o qualsevol mentre l'entrada lliure és oberta
      allow get: if signed() && (me() in resource.data.profs || exists(memberDoc(gid))
        || resource.data.get('join', true) != false || exists(/databases/$(database)/documents/groups/$(gid)/invites/$(me())));
      allow list: if signed() && me() in resource.data.profs;
      allow create: if canCreate() && request.resource.data.owner == request.auth.uid && me() in request.resource.data.profs;
      // Només qui ha creat el grup pot canviar la llista de professors; el creador no es pot canviar
      allow update: if isProf(gid) && me() in request.resource.data.profs
        && request.resource.data.get('owner', null) == resource.data.get('owner', null)
        && (isOwner(gid) || (request.resource.data.profs.hasAll(resource.data.profs) && resource.data.profs.hasAll(request.resource.data.profs)));
      allow delete: if isProf(gid) && isOwner(gid);

      match /members/{uid} {
        allow get: if (signed() && request.auth.uid == uid) || isProf(gid);
        allow list: if isProf(gid);
        // Entrar al grup: amb l'entrada lliure oberta (join) o amb una invitació del professor al mateix equip
        allow create: if signed() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['email', 'name', 'team', 'joined', 'expiresAt'])
          && request.resource.data.email == me()
          && request.resource.data.name is string && request.resource.data.name.size() <= 150
          && request.resource.data.team in grp(gid).teamIds
          && (grp(gid).get('join', true) != false
              || (exists(/databases/$(database)/documents/groups/$(gid)/invites/$(me()))
                  && get(/databases/$(database)/documents/groups/$(gid)/invites/$(me())).data.team == request.resource.data.team));
        allow update, delete: if isProf(gid);
        // L'alumne només pot afegir les seves connexions (data i dispositiu, com a molt 30) i posar-hi el nom del seu compte de Google
        allow update: if signed() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['log', 'last', 'name'])
          && (!('log' in request.resource.data) || (request.resource.data.log is list && request.resource.data.log.size() <= 30))
          && (!('last' in request.resource.data) || request.resource.data.last is number)
          && (!('name' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.name == request.auth.token.name);
      }

      // INVITACIONS: alumnes que el professor afegeix a mà (el document es diu com el correu)
      match /invites/{email} {
        allow get, delete: if isProf(gid) || (signed() && me() == email);
        allow list: if isProf(gid);
        allow create, update: if isProf(gid) && request.resource.data.team in grp(gid).teamIds;
      }

      match /teams/{tid} {
        allow read: if isProf(gid) || inTeam(gid, tid);
        allow create, delete: if isProf(gid);
        allow update: if isProf(gid)
          || (inTeam(gid, tid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'data', 'delivered', 'updated'])
              && request.resource.data.get('updated', 0) is number
              && dataKeysOk() && deliveredOk() && studentEditOk(gid));

        match /files/{fid} {
          allow read: if isProf(gid) || inTeam(gid, tid);
          // L'alumnat només pot treure arxius mentre el prototip o la marca estan oberts
          allow delete: if isProf(gid) || (inTeam(gid, tid) && filesOpen(gid, tid));
          allow create, update: if isProf(gid) || (inTeam(gid, tid) && studentFileOk(gid, tid, fid));
        }
        // CAMPS OCUPATS: cada alumne marca el camp on escriu (els companys no hi poden escriure mentre tant)
        match /locks/{uid} {
          allow read: if isProf(gid) || inTeam(gid, tid);
          allow delete: if isProf(gid) || (inTeam(gid, tid) && request.auth.uid == uid);
          allow create, update: if inTeam(gid, tid) && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['f', 'n', 'at', 'expiresAt'])
            && request.resource.data.f is string && request.resource.data.f.size() <= 200
            && request.resource.data.n is string && request.resource.data.n.size() <= 150
            && request.resource.data.at is number
            && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt <= grp(gid).expiresAt;
        }
        match /prof/{part} {
          allow read: if isProf(gid)
            || (inTeam(gid, tid) && (part == 'review' || (part == 'grades' && grp(gid).showGrades == true)));
          allow write: if isProf(gid);
        }
      }
    }
  }
}
