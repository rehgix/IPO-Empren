rules_version = '2';
// Emprèn · Regles de seguretat de la base de dades.
// Només poden entrar comptes dels dominis de l'institut (línia DOMINIS).
service cloud.firestore {
  match /databases/{database}/documents {

    // DOMINIS: correus que poden entrar (professorat i alumnat)
    function domainOk() { return request.auth.token.email.lower().matches('.*@(biada[.]net)$'); }

    function signed() { return request.auth != null && request.auth.token.email_verified == true && domainOk(); }
    function me() { return request.auth.token.email.lower(); }
    function grp(gid) { return get(/databases/$(database)/documents/groups/$(gid)).data; }
    function isProf(gid) { return signed() && me() in grp(gid).profs; }
    function memberDoc(gid) { return /databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid); }
    function inTeam(gid, tid) { return signed() && exists(memberDoc(gid)) && get(memberDoc(gid)).data.team == tid; }

    // ADMINISTRADOR: aprova qui pot crear grups (ha de coincidir amb FB_ADMIN de config.js)
    function isAdmin() { return signed() && me() == 'solivares@biada.net'; }
    function canCreate() { return isAdmin() || (signed() && exists(/databases/$(database)/documents/profs/$(me()))); }
    function reqOk(email) {
      let r = request.resource.data;
      return signed() && me() == email && r.keys().hasOnly(['email', 'name', 'msg', 'at', 'status'])
        && r.email == me() && r.status == 'pending'
        && r.name is string && r.name.size() > 0 && r.name.size() <= 100
        && r.msg is string && r.msg.size() <= 500 && r.at is number;
    }

    // APARTATS OBERTS: el grup desa a «w» quan pot escriure l'alumnat cada dada ({ f: des de, u: fins a }, en mil·lisegons).
    // Una dada que no surt a «w» (grups antics o apartats nous) es pot escriure sempre.
    function winOk(w, k) { return !(k in w) || (request.time.toMillis() >= w[k].f && request.time.toMillis() < w[k].u); }
    function keyOk(aff, w, k) { return !(k in aff) || winOk(w, k); }
    function studentEditOk(gid) {
      let w = grp(gid).get('w', {});
      let aff = request.resource.data.get('data', {}).diff(resource.data.get('data', {})).affectedKeys();
      // Si només canvia la marca d'«enviat» (_meta) o cap dada, no cal mirar apartat per apartat
      return (aff.hasOnly(['_meta']) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['members'])) || keyOk(aff, w, 'idea') && keyOk(aff, w, 'empatia') && keyOk(aff, w, 'entrevistes') && keyOk(aff, w, 'definir')
        && keyOk(aff, w, 'prototip') && keyOk(aff, w, 'micro') && keyOk(aff, w, 'pestel') && keyOk(aff, w, 'dafo')
        && keyOk(aff, w, 'lean') && keyOk(aff, w, 'sost') && keyOk(aff, w, 'ebc') && keyOk(aff, w, 'agents')
        && keyOk(aff, w, 'juridica') && keyOk(aff, w, 'fiscal') && keyOk(aff, w, 'inversio') && keyOk(aff, w, 'finan')
        && keyOk(aff, w, 'prestec') && keyOk(aff, w, 'treso') && keyOk(aff, w, 'viab') && keyOk(aff, w, 'marca')
        && keyOk(aff, w, 'pitch') && keyOk(aff, w, 'p7')
        && keyOk(request.resource.data.diff(resource.data).affectedKeys(), w, 'members');
    }
    // ARXIUS: imatges i documents del prototip i el logo (màxim 1 MB i amb data d'esborrat del grup)
    function studentFileOk(gid) {
      let f = request.resource.data;
      let w = grp(gid).get('w', {});
      return f.keys().hasOnly(['name', 'kind', 'size', 'data', 'expiresAt'])
        && f.data is string && f.data.size() < 1000000
        && f.expiresAt is timestamp && f.expiresAt <= grp(gid).expiresAt
        && (winOk(w, 'prototip') || winOk(w, 'marca'));
    }

    // PROFESSORAT AUTORITZAT: el document es diu com el correu
    match /profs/{email} {
      allow get: if isAdmin() || (signed() && me() == email);
      allow list, write: if isAdmin();
    }
    // SOL·LICITUDS d'accés com a professor (una per correu)
    match /profreq/{email} {
      allow get: if isAdmin() || (signed() && me() == email);
      allow list, update, delete: if isAdmin();
      allow create: if reqOk(email);
    }

    match /groups/{gid} {
      allow get: if signed();
      allow list: if signed() && me() in resource.data.profs;
      allow create: if canCreate() && request.resource.data.owner == request.auth.uid && me() in request.resource.data.profs;
      allow update: if isProf(gid) && me() in request.resource.data.profs;
      allow delete: if isProf(gid);

      match /members/{uid} {
        allow get: if (signed() && request.auth.uid == uid) || isProf(gid);
        allow list: if isProf(gid);
        allow create: if signed() && request.auth.uid == uid
          && request.resource.data.email == me()
          && request.resource.data.team in grp(gid).teamIds;
        allow update, delete: if isProf(gid);
      }

      // INVITACIONS: alumnes que el professor afegeix a mà (el document es diu com el correu)
      match /invites/{email} {
        allow get, delete: if isProf(gid) || (signed() && me() == email);
        allow list: if isProf(gid);
        allow create, update: if isProf(gid) && request.resource.data.team in grp(gid).teamIds;
      }

      match /teams/{tid} {
        allow read: if isProf(gid) || inTeam(gid, tid);
        allow create, delete: if isProf(gid);
        allow update: if isProf(gid)
          || (inTeam(gid, tid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'data', 'delivered', 'updated'])
              && studentEditOk(gid));

        match /files/{fid} {
          allow read, delete: if isProf(gid) || inTeam(gid, tid);
          allow create, update: if isProf(gid) || (inTeam(gid, tid) && studentFileOk(gid));
        }
        match /prof/{part} {
          allow read: if isProf(gid)
            || (inTeam(gid, tid) && (part == 'review' || (part == 'grades' && grp(gid).showGrades == true)));
          allow write: if isProf(gid);
        }
      }
    }
  }
}
